{
  "name": "albatrossflavour-openvas",
  "version": "0.1.1",
  "author": "albatrossflavour",
  "summary": "Greenbone Community Edition (OpenVAS) as a docker compose stack, with scan scope built from PuppetDB",
  "license": "Apache-2.0",
  "source": "https://github.com/albatrossflavour/openvas",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/docker",
      "version_requirement": ">= 10.0.0 < 11.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 8.0.0 < 12.0.0"
    },
    {
      "name": "puppet/logrotate",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    },
    {
      "name": "puppetlabs/node_encrypt",
      "version_requirement": ">= 3.0.0 < 4.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "24.04",
        "26.04"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "pdk-version": "4.0.1",
  "template-url": "https://github.com/puppetlabs/pdk-templates#main",
  "template-ref": "heads/main-0-g8ca954f",
  "project_page": "https://github.com/albatrossflavour/openvas",
  "issues_url": "https://github.com/albatrossflavour/openvas/issues",
  "tags": [
    "greenbone",
    "openvas",
    "gvm",
    "vulnerability",
    "scanner",
    "security",
    "docker",
    "compose"
  ]
}
